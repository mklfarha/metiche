package view

import (
	"github.com/mklfarha/metiche/frontend/internal/model"
	"github.com/mklfarha/metiche/frontend/internal/state"
)

// ConflictsPage lists what wants a human. Every card leads with the suggested
// action, because a conflict without one is noise by definition.
templ ConflictsPage(s state.Snapshot) {
	<div class="main full">
		<div class="stage">
			<div class="page">
				<h2>Conflicts</h2>
				<div class="sub">
					Advisory, always. Nothing here blocked anybody — it is a record of collisions
					detected at the moment they were declared.
				</div>
				if len(s.OpenConflicts()) == 0 {
					<div class="empty">
						<div class="glyph">✓</div>
						<div class="title">Nothing open</div>
						<div class="hint">No collisions detected across the live sessions.</div>
					</div>
				}
				for _, c := range s.OpenConflicts() {
					@conflictCard(s, c, true)
				}
				if len(s.ClosedConflicts()) > 0 {
					<h2 style="margin-top:22px">Settled</h2>
					<div class="sub">Kept so the team can see how a collision actually ended.</div>
					for _, c := range s.ClosedConflicts() {
						@conflictCard(s, c, false)
					}
				}
			</div>
		</div>
	</div>
}

templ conflictCard(s state.Snapshot, c *model.Conflict, open bool) {
	<div
		id={ c.Key }
		class={ "card", templ.KV("sev-"+c.Severity, open), templ.KV("settled", !open) }
	>
		<div class="card-head">
			<span class={ "badge", conflictBadge(c) }>
				<span class="glyph">{ severityGlyph(c.Severity) }</span>
				{ c.Severity }
			</span>
			<span class="key">{ c.Key }</span>
			<span class="badge kind">{ conflictLabel(c.Kind) }</span>
			if c.DecisionKey != "" {
				<a class="badge kind dec-key" href={ decisionURL(s.Team.Slug, c.DecisionKey) } title="the decision this plan contradicts">{ c.DecisionKey }</a>
			}
			if c.IssueRef != "" {
				<span class="badge kind dup-issue" title="the issue both plans name">{ c.IssueRef }</span>
			}
			if !c.EscalatedAt.IsZero() {
				<span class="badge dec-asked" title={ "metiche asked a person at " + runStamp(c.EscalatedAt) + ", because the agents had not settled it" }>a person was asked { clock(c.EscalatedAt) }</span>
			}
			if text, class, show := ageBadge(s, c); show {
				<span class={ "badge", class } title="how long this has been open, against what this cadence tolerates">{ text }</span>
			}
			<div class="right">
				if !open {
					<span class="badge good">{ c.Status }</span>
					if c.Resolution != "" {
						<span class="badge plain" title="how it was resolved">{ c.Resolution }</span>
					}
					if !c.ResolvedAt.IsZero() {
						<span class="badge plain" title={ c.ResolvedAt.UTC().Format("2006-01-02 15:04 UTC") }>
							settled { c.ResolvedAt.UTC().Format("15:04 UTC") } · { state.Ago(s.Now, c.ResolvedAt) } ago
						</span>
					}
				} else {
					<span class="badge plain">{ c.Status } · { state.Ago(s.Now, c.RaisedAt) }</span>
				}
			</div>
		</div>
		if c.Detail != "" {
			<div class="detail">{ c.Detail }</div>
		}
		if len(c.Plans) > 0 {
			@dupPlans(c)
		}
		if !open && c.ResolutionNote != "" {
			// How it was settled replaces what to do: a settled conflict has
			// nothing left to do, and the explanation is what a teammate reads.
			<div class="suggest settled-note">
				<span class="tag">how it was settled</span>
				<span class="text">{ c.ResolutionNote }</span>
			</div>
		} else if action := suggestedAction(s, c); action != "" {
			<div class="suggest">
				<span class="tag">do this</span>
				<span class="text">{ action }</span>
			</div>
			if open && c.JudgeNote != "" {
				// The plan's own agent judged it; its confidence and reason are
				// on the board so a person can weigh a self-judged verdict.
				<div class="suggest dec-judge">
					<span class="tag">what the judge said</span>
					<span class="text">{ c.JudgeNote }</span>
				</div>
			}
		} else if open {
			<div class="suggest" style="border-left-color:var(--critical)">
				<span class="tag" style="color:var(--critical)">defect</span>
				<span class="text">
					Raised with no suggested action. That is a detector bug, not a team problem.
				</span>
			</div>
		}
		if len(c.Paths) > 0 && len(c.Plans) == 0 {
			// A duplicate's paths are its plans' paths, already on each plan.
			<div class="paths" style="margin-bottom:8px">
				for _, p := range c.Paths {
					<div class={ "path", "hot-"+c.Severity }><span>{ p }</span></div>
				}
			</div>
		}
		<div class="parties">
			for _, p := range c.Participants {
				<span class={ "party", partyClass(p.Role) }>
					<span class="role">{ p.Role }</span>
					<span>{ s.SessionLabel(p.SessionKey) }</span>
					if p.Detail != "" {
						<span style="color:var(--ink-3)">{ p.Detail }</span>
					}
				</span>
			}
		</div>
		// No resolve / acknowledge / dismiss buttons. The board is a read-only
		// public page: a conflict is resolved by the agents through the
		// backend, and the resolution arrives here on the stream. The buttons
		// that used to be here posted to this service, which applied a made-up
		// event and broadcast it to every viewer.
	</div>
}

// dupPlans is the middle of a duplicate_work card (docs/DUPLICATES.md §5.2):
// the two plans that look like the same work, side by side, each with its
// key, whose it is, what it says and the path it holds; the one the server
// asked to yield is badged, with the reason; then why the server paired them.
// Every class is prefixed dup-: .who and .empty already mean something else
// on this board.
templ dupPlans(c *model.Conflict) {
	<div class="dup-plans">
		for _, p := range c.Plans {
			<div class={ "dup-plan", templ.KV("dup-yields", p.Yields) }>
				<div class="dup-plan-head">
					<span class="dup-key">{ p.Key }</span>
					if p.Yields {
						<span class="badge dup-stop" title="the plan declared (or reworded) later is the one asked to yield: ordering assigns responsibility, not permission">asked to stop</span>
					}
				</div>
				<div class="dup-who">{ p.Who }</div>
				<div class="dup-summary">“{ p.Summary }”</div>
				if p.Path != "" {
					<div class="dup-path" title={ p.Path }>{ p.Path }</div>
				}
				<div class="dup-reason">{ dupReason(p) }</div>
			</div>
		}
	</div>
	if len(c.Signals) > 0 {
		<div class="dup-signals">
			<span class="dup-signals-k">why paired</span>
			for _, sig := range c.Signals {
				<span class="dup-chip">{ sig }</span>
			}
		</div>
	}
}
