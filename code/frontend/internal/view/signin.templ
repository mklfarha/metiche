package view

// The sign-in page's messages. signin.js only toggles which state is shown;
// every word is here, in the server-rendered page.
const (
	// SignInFailedMessage is the ONE failure message: used, expired, unknown,
	// retired agent and inactive account all read the same (BOARD_LOGIN §2.5).
	SignInFailedMessage = "This sign-in link has already been used or has expired. Links work once, for 10 minutes. Get a new one with metiche open, or ask your assistant to open the metiche board."
	// SignInUnavailableMessage is shown when the backend could not answer. The
	// page keeps the link in sessionStorage so a reload retries it.
	SignInUnavailableMessage = "metiche is unavailable right now. If you have not used this link yet, reload this page within its 10 minutes."
	// SignInRateLimitedMessage is the board's 429. The link never reached the
	// backend, so it is kept and a reload retries it.
	SignInRateLimitedMessage = "Too many sign-in attempts from this network. Wait a minute, then reload this page; the link still works for its 10 minutes."
	// SignInForbiddenMessage is the board's 403: the request did not come
	// from this site's own page (Origin or Sec-Fetch-Site). The link never
	// reached the backend and is kept.
	SignInForbiddenMessage = "The sign-in request did not come from this page. Open the sign-in link in the same browser, directly: paste it into the address bar instead of opening it from another page or app."
)

// SignInPage is GET /signin. It is static: the same bytes for every visitor,
// with no inline script and no inline style, so it runs under
// "script-src 'self'" with nothing to allow.
//
// The link arrives as a URL fragment (/signin#mbl_…), which a browser never
// transmits. /static/signin.js takes it out of the address bar before any
// request, then POSTs it to /signin in the body. The page shows one of six
// states; with JavaScript off the explanation stays up and <noscript> says why
// the link cannot work.
templ SignInPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="referrer" content="no-referrer"/>
			<title>sign in · metiche</title>
			<link rel="icon" href="/static/metiche-icon.png" type="image/png"/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<div class="join signin">
				<div class="join-inner">
					<div class="brandbig">
						<img src="/static/metiche-icon.png" alt="" width="46" height="46"/>
						<h1>metiche<span class="dot">.</span></h1>
					</div>
					<div class="empty signin-state" id="signin-explain" data-state="explain">
						<div class="glyph">→</div>
						<div class="title">Sign in to metiche</div>
						<div class="hint">
							Sign in from your terminal: <code>metiche open</code>, or ask your assistant to open the metiche board.
							The link it opens signs this browser in once, and works for 10 minutes.
						</div>
					</div>
					<div class="empty signin-state" id="signin-progress" data-state="progress" role="status" hidden>
						<div class="glyph">…</div>
						<div class="title">Signing you in</div>
					</div>
					<div class="empty signin-state" id="signin-failed" data-state="failed" role="alert" hidden>
						<div class="glyph">×</div>
						<div class="title">That link did not work</div>
						<div class="hint">{ SignInFailedMessage }</div>
					</div>
					<div class="empty signin-state" id="signin-unavailable" data-state="unavailable" role="alert" hidden>
						<div class="glyph">!</div>
						<div class="title">Not signed in yet</div>
						<div class="hint">{ SignInUnavailableMessage }</div>
					</div>
					<div class="empty signin-state" id="signin-rate-limited" data-state="rate-limited" role="alert" hidden>
						<div class="glyph">!</div>
						<div class="title">Not signed in yet</div>
						<div class="hint">{ SignInRateLimitedMessage }</div>
					</div>
					<div class="empty signin-state" id="signin-forbidden" data-state="forbidden" role="alert" hidden>
						<div class="glyph">!</div>
						<div class="title">Not signed in</div>
						<div class="hint">{ SignInForbiddenMessage }</div>
					</div>
					<noscript>
						<div class="note signin-noscript">
							Signing in needs JavaScript, and so does the board. Turn it on, then run
							<code>metiche open</code> again for a new link.
						</div>
					</noscript>
					<div class="note"><a class="nf-link" href="/teams">See the demo teams →</a></div>
				</div>
			</div>
			<script src="/static/signin.js"></script>
		</body>
	</html>
}
