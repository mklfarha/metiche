package view

import (
	"context"
	"encoding/json"
	"fmt"
	"github.com/mklfarha/metiche/frontend/internal/state"
)

// Viewer is who is looking at a page: anonymous (the zero value), or a
// browser signed in to one account.
//
// It travels on the context, like WithDemo, and not as a parameter of every
// page: the web layer resolves it once per request and every page's chrome
// reads the same value. That also keeps NotFound honest: its only inputs are
// the slug that was asked for and this viewer, so it cannot render
// differently for an unknown team, a private team seen anonymously, or a
// private team seen by a signed-in non-member.
type Viewer struct {
	// SignedIn is false for an anonymous viewer, and then nothing else is read.
	SignedIn bool
	// DisplayName is the account's display name, shown in the indicator.
	DisplayName string
	// CSRFToken is the synchronizer token for this session (BOARD_LOGIN §6.3).
	// Every POST form carries it as the "csrf" field; htmx sends it as
	// X-CSRF-Token from the <body>'s hx-headers.
	CSRFToken string
	// Member is true when the backend confirmed, for this request, that the
	// signed-in viewer is a live member of the team the page is for. It is
	// what puts the Invites tab in the topbar; everybody else never sees it.
	Member bool
}

type viewerKey struct{}

// WithViewer attaches the resolved viewer to a render.
func WithViewer(ctx context.Context, v Viewer) context.Context {
	return context.WithValue(ctx, viewerKey{}, v)
}

// ViewerFrom returns the viewer WithViewer attached, or the anonymous viewer.
func ViewerFrom(ctx context.Context) Viewer {
	v, _ := ctx.Value(viewerKey{}).(Viewer)
	if !v.SignedIn {
		return Viewer{}
	}
	return v
}

// csrfHeaders is the hx-headers value: JSON, so htmx attaches the token to
// every request it makes from this page.
func csrfHeaders(v Viewer) string {
	b, _ := json.Marshal(map[string]string{"X-CSRF-Token": v.CSRFToken})
	return string(b)
}

// Layout is the page chrome. The SSE connection is opened once, here, on the
// <body>: both named event types arrive on the same stream, and the two swap
// targets inside the page pick the one they care about.
//
// sse-connect carries ?after=0 for a cold load. A browser that drops and
// reconnects re-sends Last-Event-ID automatically and the server resumes from
// that instead, which is why the query parameter can stay static.
templ Layout(s state.Snapshot, tab Tab, streamURL string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			if ViewerFrom(ctx).SignedIn {
				<meta name="csrf-token" content={ ViewerFrom(ctx).CSRFToken }/>
			}
			if IsDemo(ctx) {
				<title>demo · { s.Team.Name } · metiche</title>
			} else {
				<title>{ s.Team.Name } · metiche</title>
			}
			<link rel="icon" href="/static/metiche-icon.png" type="image/png"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/htmx-ext-sse.js"></script>
		</head>
		<body
			hx-ext="sse"
			sse-connect={ streamURL }
			if ViewerFrom(ctx).SignedIn {
				hx-headers={ csrfHeaders(ViewerFrom(ctx)) }
			}
		>
			<div class="app">
				@topbar(s, tab)
				if IsDemo(ctx) {
					@demoBanner()
				}
				@body
			</div>
			<script src="/static/board.js"></script>
		</body>
	</html>
}

// demoBanner sits outside the board container, so the SSE "board" frame that
// replaces that container never removes it. It is styled by .demo-banner in
// app.css, which every board page loads before this renders; the words carry
// the label on their own even if that stylesheet fails.
templ demoBanner() {
	<div class="demo-banner" role="note" data-demo="recording">
		<span class="what">
			<b>DEMO · a recording.</b>
			This team is not real: it is a recorded session replaying on a loop, so nothing on this board is live data.
		</span>
		<a href="/#join">Put your own team on metiche →</a>
	</div>
}

templ topbar(s state.Snapshot, tab Tab) {
	<header class="topbar">
		<div class="brand">
			<a class="logo" href="/" style="display:flex;align-items:center;gap:9px">
				<img class="mark" src="/static/metiche-icon.png" alt="" width="26" height="26"/>
				<span>metiche<span class="dot">.</span></span>
			</a>
			<span class="team"><b>{ s.Team.Name }</b></span>
		</div>
		<nav class="tabs">
			@tab_(tab, TabBoard, "Board", fmt.Sprintf("/t/%s", s.Team.Slug), "nav-n-board", s.LiveSessions(), false, false)
			@tab_(tab, TabGraph, "Graph", fmt.Sprintf("/t/%s/graph", s.Team.Slug), "nav-n-graph", 0, false, false)
			@tab_(tab, TabConflicts, "Conflicts", fmt.Sprintf("/t/%s/conflicts", s.Team.Slug), "nav-n-conflicts", len(s.OpenConflicts()), len(s.OpenConflicts()) > 0, false)
			@tab_(tab, TabContracts, "Contracts", fmt.Sprintf("/t/%s/contracts", s.Team.Slug), "nav-n-contracts", len(s.Contracts), false, false)
			@tab_(tab, TabDecisions, "Decisions", fmt.Sprintf("/t/%s/decisions", s.Team.Slug), "nav-n-decisions", len(s.Decisions), false, false)
			@tab_(tab, TabRuns, "Runs", fmt.Sprintf("/t/%s/runs", s.Team.Slug), "nav-n-runs", len(s.Sessions), false, false)
			@tab_(tab, TabActivity, "Activity", fmt.Sprintf("/t/%s/activity", s.Team.Slug), "nav-n-activity", 0, false, false)
			if ViewerFrom(ctx).Member {
				@tab_(tab, TabInvites, "Invites", fmt.Sprintf("/t/%s/invites", s.Team.Slug), "nav-n-invites", 0, false, false)
			}
		</nav>
		<div class="spacer"></div>
		@cadenceLabel(s)
		<div class="cursors">
			<span class="cursor seq" title="sequence — advances on every event, appends to the timeline">
				<span class="k">seq</span>
				<span class="v" id="cursor-seq">{ fmt.Sprint(s.Team.Sequence) }</span>
			</span>
			<span class="cursor rev" title="board_revision — advances only on structural change, repaints the board">
				<span class="k">rev</span>
				<span class="v" id="cursor-rev">{ fmt.Sprint(s.Team.BoardRevision) }</span>
			</span>
		</div>
		<div class="conn"><span class="pip"></span><span id="conn-label">live</span></div>
		@ViewerIndicator(ViewerFrom(ctx))
	</header>
}

// ViewerIndicator says who this browser is signed in as, with a way out; for
// an anonymous viewer it is a way in. Sign out is a POST form carrying the
// CSRF token: GET never changes state (BOARD_LOGIN §6.3).
templ ViewerIndicator(v Viewer) {
	if v.SignedIn {
		<div class="who" data-viewer="signed-in">
			<a class="who-name" href="/account" title="Your account and signed-in browsers">
				<span class="k">signed in as</span>
				<b>{ v.DisplayName }</b>
			</a>
			<form class="who-out" method="post" action="/signout">
				<input type="hidden" name="csrf" value={ v.CSRFToken }/>
				<button class="who-btn" type="submit">Sign out</button>
			</form>
		</div>
	} else {
		<div class="who" data-viewer="anonymous">
			<a class="who-btn" href="/signin">Sign in</a>
		</div>
	}
}

// cadenceLabel is visible on every page on purpose. Cadence silently changes
// what the board tells people to do, and a setting like that left wrong is
// invisible until its advice is wrong — so it states itself, in the header,
// next to the thing it governs.
//
// It is READ-ONLY. The board is a public, unauthenticated page, and it has no
// way to change anything: pace is set by the team through the backend, and
// arrives here like every other fact. It used to be a <select> that posted
// to this service, which applied a made-up event and broadcast it to every
// viewer of the board.
templ cadenceLabel(s state.Snapshot) {
	<span class="cadence" title={ cadenceHint(s.Project.Cadence) }>
		<span class="k">pace</span>
		<span style="font-family:var(--mono);font-size:11.5px;font-weight:600;color:var(--ink)">{ s.Project.Cadence.Label() }</span>
	</span>
}

templ tab_(active Tab, self Tab, label string, href string, id string, count int, hot bool, oob bool) {
	<a
		href={ templ.SafeURL(href) }
		if active == self {
			class="on"
		}
	>
		{ label }
		@navBadge(id, count, hot, oob)
	</a>
}

// navBadge is always in the DOM, even at zero, because an out-of-band swap
// needs a target that already exists. Hiding it is a CSS concern.
templ navBadge(id string, count int, hot bool, oob bool) {
	<span
		id={ id }
		class={ "n", templ.KV("hot", hot) }
		hidden?={ count == 0 }
		if oob {
			hx-swap-oob="true"
		}
	>{ fmt.Sprint(count) }</span>
}

// NavCounts is the out-of-band half: the counts in the nav belong to the
// header, not to the board container, so a board repaint ships them
// separately rather than dragging the whole header along.
templ NavCounts(s state.Snapshot) {
	@navBadge("nav-n-board", s.LiveSessions(), false, true)
	@navBadge("nav-n-conflicts", len(s.OpenConflicts()), len(s.OpenConflicts()) > 0, true)
	@navBadge("nav-n-contracts", len(s.Contracts), false, true)
	@navBadge("nav-n-decisions", len(s.Decisions), false, true)
	@navBadge("nav-n-runs", len(s.Sessions), false, true)
}
