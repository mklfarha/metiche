# syntax=docker/dockerfile:1
############################
# STEP 1 build executable binary
############################

FROM golang:alpine AS builder

# Install git.
# Git is required for fetching the dependencies.
RUN apk add --no-cache git

# set directory for all go code
WORKDIR $GOPATH/src/metiche

# Fetch dependencies first, keyed only on the module files. This layer is reused
# across rebuilds while go.mod/go.sum are unchanged (the common case — a code
# change rarely touches dependencies), so a re-deploy skips re-downloading every
# module. The cache mount also persists the module cache on the box between builds.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# Now the rest of the source; a code change only invalidates from here down.
COPY . .

# Reconcile go.mod with the source (adds any modules the custom app zone imports;
# already-fetched modules come from the cache, so this hits the network only for
# genuinely new dependencies), then build reusing the module + compile caches.
#
# `go build ./...` first: building only the main package silently ignores any
# package nothing imports, which is how a custom app/ zone that the generated
# main.go no longer wires in (a deploy that dropped --custom, say) kept producing
# a green image while its code never compiled at all. It compiles everything as a
# check and discards the objects — `go build .` then links the binary itself,
# reusing the compile cache, so this costs a link rather than a second build.
RUN --mount=type=cache,target=/go/pkg/mod go mod tidy
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build ./... && go build .

############################
# STEP 2 final thin build
############################
FROM alpine:3.22.1
ENV ENV=prod
RUN apk --no-cache add bash curl ca-certificates
WORKDIR /root/
COPY --from=builder /go/src/metiche .
ENTRYPOINT ["bash", "-c", "/root/metiche"]
