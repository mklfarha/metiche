# columns.policy — what the nuzur agent may see of each metiche column.
#
# Read by deploy/sql/nuzur/gen-views.sh. Design: docs/NUZUR_AGENT.md §5.
# This file is committed and holds no secrets.
#
#   <table>.<column>   expose | expose! | redact   [reason]
#
#   expose    the column appears as is.
#   expose!   an ACKNOWLEDGED exposure of a risky-looking name. Needs a reason.
#   redact    the column appears under its own name as a typed NULL. Needs a reason.
#
# TOTAL CLASSIFICATION. Every column of every table in metiche has exactly one
# line. A new table or column with no line, a line for a column that no longer
# exists, a duplicate, or a risky-looking name (token, secret, code, key, pass,
# pwd, url, uri, snapshot, hash, salt, credential, cookie, signature, private,
# webhook, dsn, auth, email, user_agent, ip) marked plain `expose` stops the
# generator before any SQL is produced. CI and the daily drift check run it.
#
# When a migration adds a column: add its line here IN THE SAME CHANGE, then
# after the migration is applied on the box run
#   deploy/sql/nuzur/gen-views.sh apply
# Until then the views stay as they were: stale, never wider.
#
# D2 = owner decision, docs/NUZUR_AGENT.md §2. The viewer is the owner only (D1).

# ── plan ─────────────────────────────────────────────────────────────────────
plan.id                                     expose
plan.key                                    expose!   public plan identifier, not a credential
plan.name                                   expose
plan.description                            expose
plan.max_concurrent_agents                  expose
plan.retention_days                         expose
plan.max_members                            expose
plan.max_projects                           expose
plan.is_instance_default                    expose
plan.sort_order                             expose
plan.status                                 expose
plan.created_at                             expose
plan.updated_at                             expose

# ── account ──────────────────────────────────────────────────────────────────
account.id                                  expose
account.key                                 expose!   public account handle, not a credential
account.display_name                        expose
account.token_hash                          redact    D2 hash of the account bearer token
account.identity_provider                   expose
account.identity_subject                    expose
account.identity_handle                     expose
account.email                               expose!   D2 owner-only viewer
account.claimed_at                          expose
account.status                              expose
account.last_seen_at                        expose
account.created_at                          expose
account.updated_at                          expose

